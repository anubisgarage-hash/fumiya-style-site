 "css": "body{margin:0;background:#0B0B0C}\na{color:#C9A96E}a:hover{color:#E2C994}\na:focus-visible{outline:2px solid #C9A96E;outline-offset:3px}\n.lbl{margin:0;font-family:'Cormorant Garamond',serif;font-size:13px;letter-spacing:.5em;color:#C9A96E}\n.h2{margin:0;font-family:'Shippori Mincho',serif;font-weight:500;font-size:clamp(22px,6vw,32px);line-height:1.6;letter-spacing:.1em}\n.txt{margin:0;font-size:16px;color:#D6D1C8}\n.sub{margin:0;font-size:15px;color:#A39E95}\n.row{padding:22px 0;border-top:1px solid #2A2722;display:flex;gap:18px}\n.num{font-family:'Cormorant Garamond',serif;font-size:22px;color:#C9A96E;line-height:1.4;min-width:28px}\n.ttl{font-family:'Shippori Mincho',serif;font-size:18px}\n.fs-mlink{display:flex;align-items:baseline;justify-content:space-between;gap:16px;min-height:56px;padding:14px 0;border-bottom:1px solid #2A2722;color:#EDE8DF;text-decoration:none;font-family:'Cormorant Garamond',serif;font-size:24px;letter-spacing:.14em}\n.fs-mlink small{font-family:'Noto Sans JP',sans-serif;font-size:12px;letter-spacing:.1em;color:#A39E95}\n.fs-msub{min-height:44px;display:flex;align-items:center;color:#C9A96E;text-decoration:none;font-family:'Cormorant Garamond',serif;font-size:16px;letter-spacing:.2em}\nhtml{scroll-behavior:smooth;-webkit-text-size-adjust:100%}\n*,*::before,*::after{box-sizing:border-box}\nimg{max-width:100%;height:auto}\n.fld{min-height:52px;padding:0 14px;background:#0B0B0C;border:1px solid #3A3427;color:#EDE8DF;font-size:16px;font-family:inherit;border-radius:0;width:100%}\n.fld:focus{border-color:#C9A96E;outline:none}\n.pill{position:relative;display:inline-flex}\n.pill input{position:absolute;opacity:0;width:1px;height:1px}\n.pill span{min-height:44px;padding:0 14px;display:inline-flex;align-items:center;font-size:13px;border:1px solid #3A3427;color:#D6D1C8;cursor:pointer}\n.pill input:checked+span{background:#C9A96E;border-color:#C9A96E;color:#0B0B0C}\n.pill input:focus-visible+span{outline:2px solid #C9A96E;outline-offset:3px}\n@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}",
 "header": "<div style=\"background: #0B0B0C; color: #EDE8DF; font-family: 'Noto Sans JP', sans-serif; font-size: 16px; line-height: 1.9; letter-spacing: 0.04em; min-height: 100vh\">\n\n<header style=\"position: sticky; top: 0; z-index: 20; background: rgba(11,11,12,0.94); border-bottom: 1px solid #23211D\">\n<div style=\"max-width: 1200px; margin: 0 auto; padding: 8px 12px 8px 20px; display: flex; align-items: center; justify-content: space-between; gap: 8px\">\n<a href=\"/\" style=\"display: flex; flex-direction: column; gap: 4px; text-decoration: none\">\n<span style=\"font-family: 'Cormorant Garamond', serif; font-size: 18px; line-height: 1.2; letter-spacing: 0.2em; white-space: nowrap; color: #D9BD84\">FUMIYA STYLE</span>\n<span style=\"font-size: 8px; line-height: 1.4; letter-spacing: 0.22em; white-space: nowrap; color: #D6D1C8\">PERSONAL BRAND &amp; BUSINESS</span>\n</a>\n<div style=\"display: flex; align-items: center; flex: none\">\n<a href=\"https://www.instagram.com/fumiya.style/\" target=\"_blank\" rel=\"noopener\" aria-label=\"Instagram（新しいタブで開く）\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; color: #D9BD84\">\n<svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"5\"></rect><circle cx=\"12\" cy=\"12\" r=\"4\"></circle><circle cx=\"17.3\" cy=\"6.7\" r=\"0.6\" fill=\"currentColor\"></circle></svg>\n</a>\n<a href=\"https://www.tiktok.com/@fumiya.style\" target=\"_blank\" rel=\"noopener\" aria-label=\"TikTok（新しいタブで開く）\" style=\"width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; color: #D9BD84\">\n<svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5\"></path><path d=\"M14 3c.4 2.6 2.2 4.4 5 4.6\"></path></svg>\n</a>\n<span aria-hidden=\"true\" style=\"width: 1px; height: 28px; margin: 0 4px; background: #6A5C40\"></span>\n<button type=\"button\" id=\"fs-menu-open\" aria-label=\"メニューを開く\" style=\"width: 44px; height: 44px; padding: 0; background: transparent; border: 0; display: flex; align-items: center; justify-content: center; color: #D9BD84; cursor: pointer\">\n<svg width=\"28\" height=\"20\" viewBox=\"0 0 28 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><line x1=\"0\" y1=\"1\" x2=\"28\" y2=\"1\"></line><line x1=\"0\" y1=\"10\" x2=\"28\" y2=\"10\"></line><line x1=\"0\" y1=\"19\" x2=\"28\" y2=\"19\"></line></svg>\n</button>\n</div>\n</div>\n</header>\n\n\n<div id=\"fs-menu\" hidden role=\"dialog\" aria-modal=\"true\" aria-label=\"メニュー\" style=\"position: fixed; inset: 0; z-index: 50; background: #0B0B0C; overflow-y: auto\">\n<div style=\"max-width: 1200px; margin: 0 auto; padding: 12px 12px 0 20px; display: flex; align-items: flex-start; justify-content: space-between\">\n<span style=\"display: flex; flex-direction: column; gap: 4px; padding-top: 6px\">\n<span style=\"font-family: 'Cormorant Garamond', serif; font-size: 18px; line-height: 1.2; letter-spacing: 0.2em; white-space: nowrap; color: #D9BD84\">FUMIYA STYLE</span>\n<span style=\"font-size: 8px; line-height: 1.4; letter-spacing: 0.22em; white-space: nowrap; color: #D6D1C8\">PERSONAL BRAND &amp; BUSINESS</span>\n</span>\n<button type=\"button\" id=\"fs-menu-close\" aria-label=\"メニューを閉じる\" style=\"width: 44px; height: 44px; padding: 0; background: transparent; border: 0; display: flex; align-items: center; justify-content: center; color: #D9BD84; cursor: pointer\">\n<svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><line x1=\"2\" y1=\"2\" x2=\"20\" y2=\"20\"></line><line x1=\"20\" y1=\"2\" x2=\"2\" y2=\"20\"></line></svg>\n</button>\n</div>\n<nav aria-label=\"サイトメニュー\" style=\"max-width: 640px; margin: 0 auto; padding: 32px 28px 56px; display: flex; flex-direction: column\">\n<a href=\"/#philosophy\" class=\"fs-mlink\"><span>PHILOSOPHY</span><small>経営哲学</small></a>\n<a href=\"/#about\" class=\"fs-mlink\"><span>ABOUT</span><small>佐野史弥について</small></a>\n<a href=\"/#approach\" class=\"fs-mlink\"><span>HOW I WORK</span><small>向き合い方</small></a>\n<a href=\"/#business\" class=\"fs-mlink\"><span>BUSINESS</span><small>事業領域</small></a>\n<div style=\"display: flex; flex-direction: column; padding: 4px 0 12px 16px; border-bottom: 1px solid #2A2722\">\n<a href=\"https://anubis-nagoya.com/\" target=\"_blank\" rel=\"noopener\" class=\"fs-msub\">ANUBIS NAGOYA ↗</a>\n<a href=\"/branding/\" class=\"fs-msub\">BRANDING</a>\n<a href=\"/global.html\" class=\"fs-msub\">GLOBAL BUSINESS</a>\n<a href=\"/matching.html\" class=\"fs-msub\">BUSINESS MATCHING</a>\n<a href=\"/system.html\" class=\"fs-msub\">SYSTEM DEVELOPMENT</a>\n</div>\n<a href=\"/people.html\" class=\"fs-mlink\"><span>MY PEOPLE.</span><small>信頼する仲間たち</small></a>\n<a href=\"/#connect\" class=\"fs-mlink\"><span>CONNECT</span><small>SNS</small></a>\n<a href=\"/#contact\" style=\"margin-top: 32px; min-height: 56px; display: flex; align-items: center; justify-content: center; background: #C9A96E; color: #0B0B0C; font-size: 16px; font-weight: 500; letter-spacing: 0.2em; text-decoration: none\">事業について相談する</a>\n</nav>\n</div>\n\n\n",
 "footer": "<footer style=\"padding: 48px 24px 64px; border-top: 1px solid #23211D\">\n<div style=\"max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 12px\">\n<p style=\"margin: 0; font-family: 'Cormorant Garamond', serif; font-size: 22px; letter-spacing: 0.32em\">FUMIYA STYLE</p>\n<a href=\"/privacy.html\" style=\"min-height: 44px; display: flex; align-items: center; font-size: 14px\">プライバシーポリシー</a>\n<p style=\"margin: 0; font-size: 12px; color: #6E6A63\">© FUMIYA STYLE</p>\n</div>\n</footer>\n\n</div>",
 "menu_js": "(function(){var m=document.getElementById('fs-menu'),o=document.getElementById('fs-menu-open'),c=document.getElementById('fs-menu-close');if(!m||!o)return;\nfunction open(){m.hidden=false;document.body.style.overflow='hidden';c&&c.focus();}\nfunction close(){m.hidden=true;document.body.style.overflow='';o.focus();}\no.addEventListener('click',open);c&&c.addEventListener('click',close);\nm.querySelectorAll('a[href^=\"#\"]').forEach(function(a){a.addEventListener('click',function(){m.hidden=true;document.body.style.overflow='';});});\ndocument.addEventListener('keydown',function(e){if(e.key==='Escape'&&!m.hidden)close();});})();\n",
